  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "type-check": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": { "centrifuge": "5.8.0" },
  "devDependencies": { "esbuild": "^0.28.2", "typescript": "5.9.3", "vitest": "^4.0.0" }
